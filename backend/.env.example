# "ollama" or "groq"
MEETWISE_LLM_PROVIDER=groq
# "ollama", "gemini", or "hash" (offline lexical fallback, useful for development and tests)
MEETWISE_EMBEDDING_PROVIDER=gemini

OLLAMA_BASE_URL = http://localhost:11434
MEETWISE_OLLAMA_CHAT_MODEL = qwen3.5:4b
MEETWISE_OLLAMA_EMBED_MODEL = nomic-embed-text

GROQ_API_KEY = 
MEETWISE_GROQ_CHAT_MODEL = qwen/qwen3.8-27b

GEMINI_API_KEY = 
MEETWISE_GEMINI_EMBED_MODEL = gemini-embedding-2

MEETWISE_DB_PATH = meetwise.db
# Approximate character budget per LLM call. Longer transcripts are windowed.
MEETWISE_WINDOW_CHARS = 12000
# Total extraction passes allowed when verification finds unsupported items.
MEETWISE_MAX_EXTRACTION_ATTEMPTS = 2